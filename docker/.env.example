# Copier en .env puis adapter.

# Tag de l'image publiée (voir les releases GitHub, ex. 0.1.1).
IMAGE_TAG=0.1.1

# Port d'accès à l'app dans le navigateur.
APP_PORT=8080

# --- Synchronisation entre appareils (facultatif) ----------------------------
# Sans ces deux lignes, l'app fonctionne seul, sans synchro.
# OIDC_ISSUER=https://sso.example.com/realms/mon-realm
# OIDC_CLIENT_ID=notes-pwa
# OIDC_AUDIENCE=notes-pwa

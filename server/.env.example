# Serveur Notes — configuration
# Copier en .env et adapter.

PORT=8080
HOST=0.0.0.0

# Dossier des données : notes.db + attachments/
DATA_DIR=./data

# --- Keycloak (OIDC) ---------------------------------------------------------
# URL du realm, sans slash final. Exemple :
OIDC_ISSUER=https://sso.example.com/realms/mon-realm
# Client public (Authorization Code + PKCE) créé dans Keycloak pour la PWA.
OIDC_CLIENT_ID=notes-pwa
# Optionnel : si tu veux vérifier un auditoire précis (par défaut on vérifie `azp`).
# OIDC_AUDIENCE=notes-pwa

# Origine autorisée pour le navigateur (la PWA). Laisser vide si le serveur sert
# aussi le front sur la même origine.
CORS_ORIGIN=https://notes.example.com

# Taille maximale d'une pièce jointe (image / note vocale), en octets.
MAX_UPLOAD_BYTES=26214400

{
  "name": "notes-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Serveur de synchronisation auto-hébergeable pour l'app Notes (Fastify + SQLite + OIDC).",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "check": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^13.1.1",
    "fastify": "^5.1.0",
    "jose": "^5.9.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.5"
  }
}
